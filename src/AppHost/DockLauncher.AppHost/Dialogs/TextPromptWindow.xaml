<Window x:Class="DockLauncher.AppHost.Dialogs.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        Height="260"
        MinWidth="460"
        MinHeight="260"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Title="{Binding WindowTitle}"
        Icon="../Resources/DocSoft.ico"
        Background="{StaticResource WindowBrush}"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Border Margin="14" Padding="20"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardStroke}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#F8FAFC"
                       Text="{Binding WindowTitle}" />

            <TextBlock Grid.Row="1"
                       Margin="0,14,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding PromptMessage}" />

            <TextBox Grid.Row="2"
                     Margin="0,14,0,0"
                     MinHeight="34"
                     VerticalContentAlignment="Center"
                     Text="{Binding ResponseText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="3"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="92"
                        Margin="0,0,10,0"
                        Padding="16,7"
                        Style="{StaticResource ActionButtonStyle}"
                        IsCancel="True"
                        Content="Cancel" />
                <Button MinWidth="92"
                        Padding="16,7"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Command="{Binding AcceptCommand}"
                        Content="OK" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
