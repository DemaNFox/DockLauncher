<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF142431" />

    <SolidColorBrush x:Key="WindowBrush" Color="#0B1119" />
    <SolidColorBrush x:Key="CardBrush" Color="#111B26" />
    <SolidColorBrush x:Key="CardBrushStrong" Color="#172432" />
    <SolidColorBrush x:Key="CardStroke" Color="#293A48" />
    <SolidColorBrush x:Key="InputBrush" Color="#0E1823" />
    <SolidColorBrush x:Key="InputStroke" Color="#344756" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#63D5BF" />
    <SolidColorBrush x:Key="PrimaryBrushDark" Color="#258E7D" />
    <SolidColorBrush x:Key="MutedBrush" Color="#96A8B6" />

    <LinearGradientBrush x:Key="FlyoutBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F0192A37" />
        <GradientStop Offset="1" Color="#F00D1822" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FlyoutBorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#6659CDB8" />
        <GradientStop Offset="1" Color="#33477A77" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FlyoutItemBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F0293B48" />
        <GradientStop Offset="1" Color="#E51B2A36" />
    </LinearGradientBrush>
</ResourceDictionary>
